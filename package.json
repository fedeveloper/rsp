{
  "name": "rsp",
  "version": "0.0.0",
  "description": "Rule-based verifier that reports reproducible facts about risky changes in a diff.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "rsp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "rsp": "node --import tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
