{
  "name": "rsp",
  "version": "0.4.0",
  "description": "RSP: Reproducible Shortcut Patrol. Reports reproducible facts about risky shortcuts in a pull request diff.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "rsp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "rsp": "node --import tsx src/cli.ts",
    "prepare": "npm run build",
    "bundle": "esbuild src/action-main.ts --bundle --platform=node --target=node22 --format=esm --legal-comments=eof --outfile=action-dist/index.js && node scripts/notices.mjs",
    "eval": "node --import tsx eval/run.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "smol-toml": "^1.9.1"
  }
}
